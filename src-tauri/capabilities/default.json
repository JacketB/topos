{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:default",
    "fs:default",
    "allow-read-pmtiles-chunk",
    "allow-save-scenario-file",
    "allow-export-map-native",
    "allow-search-belarus-places",
    "allow-calculate-march-route",
    "allow-get-march-overlays",
    "allow-get-elevation-at",
    "allow-get-slope-bearing",
    "allow-get-elevation-profile",
    "allow-calculate-viewshed"
  ]
}
